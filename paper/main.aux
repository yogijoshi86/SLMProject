\@writefile{toc}{\contentsline {subsection}{\numberline {6.4}Experiment 3: Decision Geometry Analysis}{7}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Decision geometry across TP/TN/FP/FN quadrants. All four groups are geometrically indistinguishable. Guard errors are \emph  {not} at cluster boundaries. Prototype identity, not geometric distance, predicts error direction.}}{8}{}\protected@file@percent }
\newlabel{tab:geometry}{{4}{8}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.5}Experiment 4: Explainability Comparison}{8}{}\protected@file@percent }
\newlabel{sec:expcomp}{{6.5}{8}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Explainability comparison on 223-case benchmark. Phi-3.5-Blind defends the guard's wrong SAFE decision in 97\% of FN cases. Phi-3.5-GT produces generic boilerplate for jailbreaks. Prototype-based explanations surface the attack pattern in 99\% of FN cases with zero API cost.}}{8}{}\protected@file@percent }
\newlabel{tab:explainability}{{5}{8}}
