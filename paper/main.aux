\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Prototype-Driven Guardrail Auditing Architecture. \textbf  {Training (offline):} Hidden states from Llama-Guard-3-8B are reduced via UMAP and clustered with K-means to discover 4 attack prototypes, persisted as \texttt  {taxonomy.json}. \textbf  {Inference (real-time):} Each new prompt is projected into the same 50-dim UMAP space, matched to the nearest prototype, and evaluated against LTL properties. \textbf  {Review:} Flagged cases are routed to developers with prototype explanations or to model-assisted review pipelines.}}{3}{}\protected@file@percent }
\newlabel{fig:architecture}{{1}{3}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Phase 3: Real-Time Matching}{3}{}\protected@file@percent }
