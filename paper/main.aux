\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}Phase 1: Hidden State Extraction}{3}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Phase 2: Prototype Discovery via UMAP + K-means}{3}{}\protected@file@percent }
\newlabel{sec:proto}{{3.2}{3}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Prototype-Driven Guardrail Auditing Architecture. \textbf  {Offline training:} UNSAFE embeddings from Llama-Guard-3-8B are projected via UMAP and clustered with K-means to yield 4 attack prototypes, persisted as a taxonomy. \textbf  {Inference:} Each new prompt is projected into the same 50-dim space, matched to the nearest prototype, and evaluated against LTL trust properties. \textbf  {Review:} Flagged cases are routed to developers with prototype explanations.}}{4}{}\protected@file@percent }
\newlabel{fig:architecture}{{1}{4}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Phase 3: Real-Time Prototype Matching}{4}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4}Phase 4: LTL Runtime Trust Monitor}{4}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Four UNSAFE attack prototypes discovered by UMAP + K-means on Llama-Guard-3-8B hidden states (304-embedding training split). S12=Sexual Content, S4=Child Exploitation, S14=Code Interpreter Abuse, S6=Specialized Advice, S8=Intellectual Property.}}{5}{}\protected@file@percent }
\newlabel{tab:prototypes}{{1}{5}}
