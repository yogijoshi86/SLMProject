\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Clustering comparison. UMAP + K-means dominates on both silhouette and coverage. BERTopic's 41.8\% outlier rate means nearly half of all UNSAFE prompts receive no explanation.}}{7}{}\protected@file@percent }
