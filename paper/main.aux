\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces A/B study results (n=4 participants with complete sessions). Prototype explanations (Treatment) reduce diagnostic latency by a mean of 46\% and improve accuracy by 12 percentage points. The H1 threshold of 30\% latency reduction was exceeded by 4/5 participants.}}{7}{}\protected@file@percent }
\newlabel{fig:ab}{{2}{7}}
