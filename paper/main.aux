\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Clustering comparison. UMAP dramatically improves silhouette and reveals a fourth prototype. BERTopic assigns 41.8\% of prompts to the outlier class, making it unsuitable for production use where every flagged case needs an explanation.}}{5}{}\protected@file@percent }
\newlabel{tab:clustering}{{3}{5}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.4}Experiment 3: Decision Geometry Analysis}{5}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Decision geometry across quadrants. All four quadrants are geometrically indistinguishable: errors are not at cluster boundaries. Prototype \emph  {identity} (not geometry) predicts error direction.}}{6}{}\protected@file@percent }
\newlabel{tab:geometry}{{4}{6}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.5}Experiment 4: Explainability Comparison}{6}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Explainability comparison on 50-case benchmark. ``Phi-3.5-GT'' = model told the guard made an error. ``Phi-3.5-Blind'' = model told only the guard's decision. Prototype explanations require no LLM call and outperform both SLM modes on FNs.}}{6}{}\protected@file@percent }
\newlabel{tab:explainability}{{5}{6}}
